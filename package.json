{
  "name": "btm-terminal-public-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "description": "BTM public Terminal interface and reusable deterministic Risk Engine V1 framework.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:risk",
    "build:risk": "tsc -p backend/tsconfig.json",
    "test:risk": "vitest run backend/risk-engine-v1.test.ts",
    "example:risk": "npm run build:risk && node backend/example.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/space-grotesk": "5.1.0",
    "lucide-react": "0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "wouter": "3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
